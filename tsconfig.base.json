{
  "compilerOptions": {
    "types": ["@types/node"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "target": "ESNext",
    "customConditions": ["source"],
    "strict": true,
    "declaration": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  }
}
