/**
 * Builds llms-full.txt by concatenating every document linked from llms.txt,
 * in order, skipping the "## Optional" section.
 *
 *   pnpm docs:llms
 */
import { readFileSync, writeFileSync } from 'node:fs';

const REPO_RAW =
  'https://raw.githubusercontent.com/andrewangelle/nhl-api-ts/main/packages/nhl-api-ts/';
const root = new URL('../', import.meta.url);
function read(path: string): string {
  return readFileSync(new URL(path, root), 'utf8');
}

const index = read('llms.txt');
const required = index.split(/^## Optional$/m)[0];

const links = [...required.matchAll(/^- \[([^\]]+)\]\(([^)]+)\)/gm)].map(
  ([, title, url]) => {
    if (!url.startsWith(REPO_RAW)) {
      throw new Error(`llms.txt link is not a repo file: ${url}`);
    }
    return { title, path: url.slice(REPO_RAW.length) };
  },
);

const header = index.slice(0, index.indexOf('\n## ')).trim();
const sections = links.map(
  ({ title, path }) =>
    `<!-- ${'='.repeat(70)} -->\n<!-- ${title}: ${path} -->\n\n${read(path).trim()}`,
);

writeFileSync(
  new URL('llms-full.txt', root),
  `${header}\n\nThis file concatenates the documents listed in llms.txt. Generated by \`pnpm docs:llms\`. Do not edit.\n\n${sections.join('\n\n')}\n`,
);
console.log(`llms-full.txt: ${links.length} documents`);
