/**
 * Writes trimmed, typed fixtures from the cached raw samples to the SDK's
 * `test/fixtures/<module>.mts`. Each fixture is real data cut down to one item
 * per array (one per variant for tagged unions), declared with its response
 * type so `pnpm typecheck:test` flags a type that no longer matches the
 * payload.
 *
 *   pnpm api-types:fixtures
 */
import { mkdirSync, writeFileSync } from 'node:fs';
import { groupAll } from '#src/infer.mjs';
import { loadSamples, type RawSample } from '#src/load.mjs';
import { RAW_DIR, SDK_DIR } from '#src/paths.mjs';
import { specFor } from '#src/specs.mjs';

const FIXTURE_DIR = `${SDK_DIR}test/fixtures/`;
const VARIANT_KEYS = ['typeDescKey'];
const MAP_KEEP = 2;

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

/** Keeps one item per array (one per variant when items carry a discriminant). */
export function trim(value: unknown): unknown {
  if (Array.isArray(value)) {
    const keep: unknown[] = [];
    const seen = new Set<string>();

    for (const item of value) {
      const key = isRecord(item)
        ? VARIANT_KEYS.map((name) => String(item[name] ?? '')).join('|')
        : '';

      if (!seen.has(key)) {
        seen.add(key);
        keep.push(trim(item));
      }
    }
    return keep;
  }

  if (isRecord(value)) {
    const entries = Object.entries(value);

    const dynamic =
      entries.length >= 5 &&
      entries.every(
        ([key]) => /^\d+$/.test(key) || /^\d{4}-\d{2}-\d{2}$/.test(key),
      );

    const reportMap =
      entries.length >= 5 &&
      entries.every(
        ([, child]) => isRecord(child) && 'season' in child && 'game' in child,
      );

    return Object.fromEntries(
      (dynamic || reportMap ? entries.slice(0, MAP_KEEP) : entries).map(
        ([key, child]) => [key, trim(child)],
      ),
    );
  }
  return value;
}

function richness(sample: RawSample): number {
  return JSON.stringify(sample.body).length;
}

function lowerFirst(text: string): string {
  return text[0].toLowerCase() + text.slice(1);
}

function fileOf(endpoint: string): string {
  return (
    {
      teams: 'teams',
      players: 'players',
      standings: 'standings',
      schedule: 'schedule',
      gameCenter: 'game-center',
      stats: 'stats',
      misc: 'misc',
      edge: 'edge',
      draft: 'draft',
    }[endpoint.split('.')[0]] ?? 'misc'
  );
}

mkdirSync(FIXTURE_DIR, { recursive: true });
const files = new Map<string, string[]>();
const used = new Map<string, Set<string>>();

for (const [key, group] of groupAll(loadSamples(RAW_DIR))) {
  const spec = specFor(group.endpoint);
  const ok = group.samples.filter((sample) => sample.status === 200);

  if (ok.length === 0) {
    continue;
  }

  const best = ok.reduce((left, right) =>
    richness(right) > richness(left) ? right : left,
  );

  let body = best.body;

  if (spec.unwrap !== undefined) {
    const inner = (body as Record<string, unknown>)[spec.unwrap];
    body = Array.isArray(inner) ? inner[0] : inner;
  }

  const suffix =
    key === group.endpoint ? '' : key.slice(group.endpoint.length + 1);

  let type: string;
  if (group.endpoint.endsWith('skaterStatsWithQueryContext')) {
    type = `SkaterReportRows['${suffix}']`;
  } else if (group.endpoint.endsWith('goalieStatsSummary')) {
    type = `GoalieReportRows['${suffix}']`;
  } else {
    type = spec.name;
  }

  const file = fileOf(group.endpoint);
  const baseName = `${lowerFirst(type.replace(/\W+/g, ''))}Fixture`;
  const names = used.get(file) ?? new Set<string>();

  let name = baseName;
  let counter = 2;

  while (names.has(name)) {
    name = `${baseName}${counter}`;
    counter += 1;
  }

  names.add(name);
  used.set(file, names);

  const rootType = type.split('[')[0];
  if (Array.isArray(body)) {
    type = `${type}[]`;
  }

  files.set(file, [
    ...(files.get(file) ?? []),
    `${rootType}|||export const ${name}: ${type} = ${JSON.stringify(trim(body))};`,
  ]);
}

for (const [file, entries] of files) {
  const types = [
    ...new Set(entries.map((entry) => entry.split('|||')[0])),
  ].sort();

  const body = entries.map((entry) => entry.split('|||')[1]);

  writeFileSync(
    `${FIXTURE_DIR}${file}.mts`,
    `// Generated by \`pnpm api-types:fixtures\`. Real API data trimmed to one item per array.\nimport type { ${types.join(', ')} } from '#src/index.mjs';\n\n${body.join('\n\n')}\n`,
  );
}

console.error(`wrote fixtures for ${[...files.keys()].join(', ')}`);
