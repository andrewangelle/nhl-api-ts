{
  "name": "nhl-api-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK and CLI for the NHL API and NHL EDGE stats (port of nhl-api-py).",
  "keywords": [
    "nhl",
    "api",
    "hockey",
    "sports",
    "edge",
    "stats",
    "sdk",
    "cli"
  ],
  "author": "andrewangelle@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewangelle/nhl-api-ts.git"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*.mjs": {
      "source": "./src/*.mts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "bin": {
    "nhl-api-ts": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsc",
    "test": "node --conditions=source --test \"test/**/*.test.mts\"",
    "test:update-snapshots": "node --conditions=source --test --test-update-snapshots \"test/**/*.test.mts\"",
    "lint:fix": "pnpm exec biome check . --write",
    "lint:check": "pnpm exec biome check .",
    "format": "pnpm exec biome format . --write",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mts,mjs}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
