{
  "name": "nhl-api-ts-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "api:report": "pnpm --filter nhl-api-ts api:report",
    "api-types:check": "pnpm --filter api-types-infer check",
    "api-types:fetch": "pnpm --filter api-types-infer fetch",
    "api-types:fixtures": "pnpm --filter api-types-infer fixtures",
    "api-types:infer": "pnpm --filter api-types-infer infer",
    "build": "pnpm --filter nhl-api-ts build",
    "changeset": "changeset",
    "docs:llms": "pnpm --filter nhl-api-ts docs:llms",
    "format": "pnpm exec biome format . --write",
    "lint:fix": "pnpm exec biome check . --write",
    "lint:check": "pnpm exec biome check .",
    "openapi:schemas": "pnpm --filter api-types-infer openapi",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:examples": "pnpm --filter nhl-api-ts typecheck:examples",
    "typecheck:scripts": "pnpm --filter nhl-api-ts typecheck:scripts",
    "typecheck:test": "pnpm --filter nhl-api-ts typecheck:test",
    "typecheck:types": "pnpm --filter nhl-api-ts typecheck:types",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mts,mjs}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
